# Which data layer the app talks to. Default "local" needs zero setup and
# syncs live across browser tabs on the same device via IndexedDB + BroadcastChannel -
# it will NOT sync across different phones and isn't meant to hold a large
# gallery. Set to "firebase" or "supabase" (and fill in the matching block
# below) to get real multi-device, multi-girl real-time sync + a real cloud
# storage bucket for photos/documents. "cloud" is a convenience alias that
# uses whichever of the two is configured (tries Supabase first).
VITE_BACKEND=local

# --- Firebase (used when VITE_BACKEND=firebase) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Supabase (used when VITE_BACKEND=supabase) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
